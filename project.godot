;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Game Project"
run/main_scene="uid://datp766fvrdct"
config/features=PackedStringArray("4.5", "Forward Plus")
config/autoload_on_startup=true

[autoload]

