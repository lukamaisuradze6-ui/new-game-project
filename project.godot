ThemeManager="*res://singleton/theme_manager.tscn"
Music="*res://singleton/Music.tscn"
SaveManager="*res://scripts/savestate/SaveManager.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=512
window/size/mode=3
window/size/window_width_override=1024
window/size/window_height_override=512
window/stretch/mode="viewport"

[input]

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)
]
